data/*.csv
data/*.zip

# Sensitive Data in Tests
tests/index/*.xlsx
tests/index/*.csv
scratch/

# Environment & Secrets
.env
.secrets
*.bak
*.swp

# OS
.DS_Store
Thumbs.db
